# URL base de la API (incluye el prefijo de version).
# En produccion apunta al dominio real de la API, siempre con HTTPS.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Direccion canonica del sitio, SIN barra final.
#
# De aqui salen el canonical, el sitemap.xml y el robots.txt. Sin ponerla se
# usa https://freshnesstouchcleaning.com, que es lo que se quiere en las
# vistas previas de Vercel: un canonical hacia produccion es lo que evita que
# las vistas previas acaben indexadas.
VITE_SITE_URL=https://freshnesstouchcleaning.com
