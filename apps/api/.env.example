# ---------------------------------------------------------------------------
# API de Freshness Touch - variables de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Origenes autorizados a llamar a la API, separados por coma.
# En produccion deben ser los dominios reales del sitio, nunca "*".
CORS_ORIGINS=http://localhost:5173

# --- Proveedor de distancia -------------------------------------------------
# mock   = simulacion local, sin coste, valores deterministas (desarrollo/demo)
# google = Google Routes API (requiere GOOGLE_MAPS_API_KEY y facturacion activa)
DISTANCE_PROVIDER=mock
# GOOGLE_MAPS_API_KEY=
DISTANCE_CACHE_TTL_SECONDS=86400
DISTANCE_CACHE_MAX_ENTRIES=5000
DISTANCE_TIMEOUT_MS=5000

# --- Limites de peticiones por IP -------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60
QUOTE_RATE_LIMIT_MAX=10

# --- Base de operaciones (origen del calculo de distancia) ------------------
COMPANY_BASE_CITY=Atlanta
COMPANY_BASE_STATE=GA
COMPANY_BASE_POSTAL_CODE=30303
