{
  "name": "@freshness/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Freshness Touch: cotizador instantaneo y catalogo de precios",
  "scripts": {
    "build": "prisma generate && nest build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "dev": "prisma generate && nest start --watch",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@freshness/i18n": "workspace:*",
    "@freshness/pricing": "workspace:*",
    "@freshness/types": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
