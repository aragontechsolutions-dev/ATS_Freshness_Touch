// ===========================================================================
// MODELO DE DATOS DE FRESHNESS TOUCH
// ===========================================================================
// Reglas que se respetan en todo el esquema:
//
// 1. DINERO EN CENTAVOS ENTEROS. Ningun importe es decimal. Los campos
//    terminan en "Cents" para que sea imposible confundirse.
//
// 2. FOTOGRAFIA DEL PRECIO, NO REFERENCIA. Una reserva guarda el precio que
//    se pacto, no un enlace a la tarifa vigente. Si manana suben los precios,
//    las reservas de ayer deben seguir mostrando lo que el cliente acepto.
//    Por eso se guarda tambien `pricingVersion`: permite reproducir el calculo.
//
// 3. FECHAS CON ZONA HORARIA (timestamptz). La empresa opera en Georgia
//    (America/New_York) pero el horario de verano cambia dos veces al ano:
//    guardar la hora sin zona provocaria citas desplazadas una hora.
//
// 4. RESERVA COMO INVITADO. Un cliente existe sin cuenta de usuario. El campo
//    `authUserId` se rellena solo si mas adelante crea contrasena.
//
// 5. BORRADO CONTROLADO. Los datos de un cliente no se borran en cascada por
//    accidente: las relaciones con historial usan Restrict.
// ===========================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // En Prisma 7 las cadenas de conexion NO van en el esquema:
  //   - Las migraciones toman la suya de `prisma.config.ts` (conexion directa,
  //     puerto 5432, porque el agrupador en modo transaccion no admite las
  //     sentencias preparadas que necesita Prisma Migrate).
  //   - La aplicacion usa un adaptador con la conexion agrupada (puerto 6543).
  // Mucha documentacion antigua todavia muestra `url` aqui: ya no es valido.
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

/// Debe mantenerse en paralelo con ServiceTypeSchema de @freshness/types.
enum ServiceType {
  STANDARD
  DEEP
  MOVE_IN_OUT
  POST_CONSTRUCTION
  AIRBNB_TURNOVER
  COMMERCIAL
}

enum Frequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Como de fina es la coincidencia del geocodificador.
///
/// NO es un adorno: decide si la distancia de un fichaje significa algo.
/// ROOFTOP es el portal; INTERPOLATED es un punto estimado sobre el tramo de
/// calle, que es lo que devuelve el Censo casi siempre y puede errar la casa
/// por decenas de metros (cientos, en una manzana rural larga).
enum GeocodePrecision {
  ROOFTOP
  INTERPOLATED
}

enum ServiceZone {
  A
  B
  C
  D
  /// El resto de Georgia. Se atiende, pero sin precio automatico.
  E
  OUT_OF_RANGE
}

enum NotificationEvent {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationAudience {
  CUSTOMER
  INTERNAL
}

/// SKIPPED no es un fallo: es "estaba apagado o sin configurar".
enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum Locale {
  en
  es
}

/// De donde salio la cotizacion. Permite medir que canal convierte.
enum QuoteSource {
  WEB
  ADMIN
  PHONE
}

enum BookingStatus {
  /// Creada pero sin deposito retenido todavia. No ocupa agenda en firme.
  PENDING_PAYMENT
  /// Deposito retenido y cita confirmada.
  CONFIRMED
  /// El equipo esta en el domicilio.
  IN_PROGRESS
  COMPLETED
  CANCELLED
  /// El cliente no estaba y no se pudo acceder.
  NO_SHOW
}

enum CancelledBy {
  CUSTOMER
  COMPANY
  SYSTEM
}

enum SeriesStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum PaymentKind {
  /// Retencion del deposito por desplazamiento (autorizacion, no cobro).
  DEPOSIT_HOLD
  /// Cobro del importe final del servicio.
  FINAL_CHARGE
  TIP
  REFUND
}

/// Debe mantenerse en paralelo con PaymentStatusSchema de @freshness/types.
enum PaymentStatus {
  /// Falta la tarjeta.
  REQUIRES_PAYMENT_METHOD
  /// Hay tarjeta y falta confirmarla.
  REQUIRES_CONFIRMATION
  /// El banco pide una verificacion adicional al titular (3D Secure).
  REQUIRES_ACTION
  /// En curso en el banco. Ni aprobado ni rechazado todavia.
  PROCESSING
  /// Autorizado y a la espera de captura: el estado del deposito retenido.
  REQUIRES_CAPTURE
  SUCCEEDED
  CANCELED
  FAILED
}

enum StaffRole {
  ADMIN
  DISPATCHER
  CLEANER
}

enum ActorType {
  SYSTEM
  STAFF
  CUSTOMER
}

/// Desde donde se hizo algo. FIELD esta previsto para la futura aplicacion
/// de campo y hoy no lo usa nadie: el equipo de limpieza entra al panel.
enum AuditSurface {
  PANEL
  SITE
  SYSTEM
  FIELD
}

// ---------------------------------------------------------------------------
// Clientes y direcciones
// ---------------------------------------------------------------------------

model Customer {
  id String @id @default(uuid()) @db.Uuid

  /// Identificador del usuario en Supabase Auth. Nulo mientras el cliente
  /// sea invitado: reservar no exige crear cuenta.
  authUserId String? @unique

  email     String @unique
  firstName String
  lastName  String
  phone     String
  locale    Locale @default(en)

  /// Consentimiento explicito para comunicaciones comerciales. Separado del
  /// correo transaccional, que no necesita consentimiento.
  marketingOptIn Boolean @default(false)

  /// Notas internas del equipo. Nunca se muestran al cliente.
  internalNotes String?

  addresses Address[]
  quotes    Quote[]
  bookings  Booking[]
  series    RecurringSeries[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@map("customers")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  line1      String
  line2      String?
  city       String
  state      String  @default("GA") @db.Char(2)
  postalCode String  @db.VarChar(10)

  /// Instrucciones de acceso: codigos de puerta, ubicacion de la llave, perro
  /// en el jardin. DATO SENSIBLE: solo debe ser visible para el equipo
  /// asignado al trabajo y para administracion, nunca en listados generales.
  accessNotes String?

  /// Ultima distancia calculada desde la base de operaciones. Se guarda para
  /// no repetir la consulta al proveedor (que se paga por uso) en cada visita.
  distanceMiles      Float?
  zone               ServiceZone?
  distanceProvider   String?
  distanceComputedAt DateTime?    @db.Timestamptz(3)

  /// Donde cae la casa en el mapa. Se resuelve UNA vez desde la direccion y
  /// se guarda, porque una casa no se mueve.
  ///
  /// Todo nulo mientras no se haya geocodificado, que es el estado normal al
  /// crear la direccion y lo sigue siendo si el servicio externo no la
  /// encuentra. Nada del sistema depende de que esto tenga valor: sin
  /// coordenadas, el fichaje simplemente no registra distancia.
  ///
  /// NO añade exposicion de privacidad: la direccion completa ya esta arriba,
  /// en texto plano. Lo que NO se guarda en ninguna parte es la ubicacion del
  /// empleado.
  latitude         Float?
  longitude        Float?
  geocodePrecision GeocodePrecision?
  geocodeProvider  String?
  geocodedAt       DateTime?         @db.Timestamptz(3)

  /// La direccion tal y como la entendio el geocodificador.
  ///
  /// Es lo unico que revela la coincidencia PLAUSIBLE pero equivocada: se
  /// pidio «123 Main St» y el servicio entendio «123 Main Ave», misma ciudad.
  /// Eso pasa la guardia del estado, guarda coordenadas validas y deja la
  /// casa a kilometro y medio. No falla: miente. Comparando las dos cadenas
  /// se ve; sin esta columna, no.
  geocodeMatchedAddress String?

  isPrimary Boolean @default(false)

  bookings  Booking[]
  series    RecurringSeries[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([postalCode])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Cotizaciones
// ---------------------------------------------------------------------------

/// Cotizacion emitida. Hasta la Etapa 1 no se guardaba ninguna; ahora se
/// conserva para poder medir cuantas terminan en reserva y para recuperar a
/// quien cotizo y no reservo.
model Quote {
  id String @id @default(uuid()) @db.Uuid

  /// Nulo cuando alguien cotiza sin dejar sus datos: en el cotizador publico
  /// solo se pide el codigo postal.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  source QuoteSource @default(WEB)
  locale Locale      @default(en)

  // --- Entrada ---
  service    ServiceType
  frequency  Frequency
  bedrooms   Int
  bathrooms  Int
  squareFeet Int
  /// Extras solicitados: [{ code, quantity }].
  addOns     Json        @default("[]")
  postalCode String      @db.VarChar(10)
  state      String      @default("GA") @db.Char(2)

  // --- Resultado (fotografia del calculo) ---
  distanceMiles   Float
  zone            ServiceZone
  /// Desglose completo de lineas tal y como se le mostro al cliente.
  lines           Json
  serviceCents    Int
  addOnsCents     Int
  surchargesCents Int
  discountCents   Int
  taxCents        Int
  totalCents      Int
  depositCents    Int
  currency        String      @default("USD") @db.Char(3)

  /// Version de la configuracion de precios usada. Sin esto, un presupuesto
  /// antiguo no se puede reproducir despues de cambiar las tarifas.
  pricingVersion String

  manualReviewReasons Json @default("[]")

  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  booking Booking?

  @@index([customerId])
  @@index([createdAt])
  @@index([postalCode])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Reservas
// ---------------------------------------------------------------------------

model Booking {
  id String @id @default(uuid()) @db.Uuid

  /// Referencia legible para hablar con el cliente por telefono: FT-2026-0001.
  reference String @unique @db.VarChar(20)

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// Cotizacion de origen, si la reserva vino del cotizador publico.
  quoteId String? @unique @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  seriesId String?          @db.Uuid
  series   RecurringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  status BookingStatus @default(PENDING_PAYMENT)

  // --- Fotografia del servicio contratado ---
  service    ServiceType
  frequency  Frequency
  bedrooms   Int
  bathrooms  Int
  squareFeet Int
  addOns     Json        @default("[]")

  // --- Agenda ---
  scheduledStart DateTime @db.Timestamptz(3)
  scheduledEnd   DateTime @db.Timestamptz(3)
  /// Zona horaria con la que se mostro la cita al cliente.
  timezone       String   @default("America/New_York")

  // --- Fotografia del precio pactado ---
  distanceMiles   Float
  zone            ServiceZone
  lines           Json
  serviceCents    Int
  addOnsCents     Int
  surchargesCents Int
  discountCents   Int
  taxCents        Int
  totalCents      Int
  depositCents    Int
  /// Total menos deposito: lo que queda por cobrar el dia del servicio.
  balanceDueCents Int
  currency        String      @default("USD") @db.Char(3)
  pricingVersion  String

  /// Indicaciones que deja el cliente al reservar.
  customerNotes String?

  // --- Cierre ---
  startedAt          DateTime?    @db.Timestamptz(3)
  completedAt        DateTime?    @db.Timestamptz(3)
  cancelledAt        DateTime?    @db.Timestamptz(3)
  cancelledBy        CancelledBy?
  cancellationReason String?

  payments         Payment[]
  assignments      BookingAssignment[]
  notifications    Notification[]
  clockIns         BookingClockIn[]
  checklistItems   BookingChecklistItem[]
  fieldAdjustments BookingFieldAdjustment[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// La agenda se consulta casi siempre por fecha y estado.
  @@index([scheduledStart, status])
  /// Ademas existe un indice PARCIAL sobre (scheduledStart) limitado a las
  /// reservas CONFIRMED, creado en la migracion 20260922000000, para el
  /// barrido del recordatorio: Prisma no sabe expresar indices parciales.
  /// Ademas existe un indice unico parcial sobre (customerId, scheduledStart)
  /// para las reservas no canceladas, creado en la migracion
  /// 20260920180000: Prisma no sabe expresar indices parciales.
  @@index([customerId])
  @@index([status])
  @@index([zone, scheduledStart])
  @@map("bookings")
}

/// Serie recurrente. Es un objeto de primer nivel y no una copia de citas
/// sueltas: asi se puede pausar, reprogramar o cambiar el precio de toda la
/// serie de una vez, que es como lo pide el negocio.
model RecurringSeries {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status    SeriesStatus @default(ACTIVE)
  frequency Frequency

  service    ServiceType
  bedrooms   Int
  bathrooms  Int
  squareFeet Int
  addOns     Json        @default("[]")

  /// 0 = domingo ... 6 = sabado, en la zona horaria de la empresa.
  dayOfWeek       Int
  /// Hora local de inicio en formato HH:MM.
  startTime       String @db.VarChar(5)
  durationMinutes Int

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  bookings  Booking[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([status])
  @@map("recurring_series")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

/// Reflejo local de cada movimiento de dinero. El proveedor de pago es la
/// fuente de verdad; esta tabla existe para poder consultar el estado sin
/// llamar a su API y para conciliar.
///
/// No dice "stripe" en ningun sitio: igual que con la distancia, el proveedor
/// se elige por configuracion. Asi el simulador puede guardar sus propios
/// movimientos sin ensuciar el modelo con identificadores que no son de quien
/// dicen ser.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  kind   PaymentKind
  status PaymentStatus

  /// Proveedor que custodia el movimiento: "mock" o "stripe".
  provider                String  @db.VarChar(20)
  /// Identificador del movimiento en ese proveedor (pi_... en Stripe).
  providerPaymentIntentId String
  providerCustomerId      String?
  /// Ultimos cuatro digitos y marca, solo para mostrarlos. NUNCA se guarda
  /// el numero de tarjeta: lo custodia el proveedor.
  cardBrand               String?
  cardLast4               String? @db.VarChar(4)

  amountAuthorizedCents Int
  amountCapturedCents   Int    @default(0)
  amountRefundedCents   Int    @default(0)
  currency              String @default("USD") @db.Char(3)

  authorizedAt DateTime? @db.Timestamptz(3)
  capturedAt   DateTime? @db.Timestamptz(3)
  canceledAt   DateTime? @db.Timestamptz(3)
  /// Una retencion caduca a los 7 dias: pasada esa fecha ya no se puede
  /// capturar y hay que volver a pedir la tarjeta.
  expiresAt    DateTime? @db.Timestamptz(3)

  /// Ultimo error devuelto por el proveedor, para soporte.
  lastErrorCode    String?
  lastErrorMessage String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Un mismo identificador puede existir en dos proveedores distintos (el
  /// simulador imita el formato de Stripe), asi que la unicidad es del par.
  @@unique([provider, providerPaymentIntentId])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

/// Registro de eventos recibidos del proveedor de pago.
///
/// El proveedor reenvia el mismo evento si no recibe un 2xx a tiempo. Sin esta
/// tabla, un reintento podria capturar dos veces el mismo deposito. La clave
/// primaria es el identificador del evento: procesarlo dos veces es imposible.
model WebhookEvent {
  /// Identificador del evento en el proveedor (evt_... en Stripe).
  id String @id

  provider      String    @default("stripe")
  type          String
  receivedAt    DateTime  @default(now()) @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)
  /// Mensaje de error si el procesamiento fallo, para poder reintentar a mano.
  failureReason String?
  payload       Json

  @@index([type])
  @@index([processedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Personal
// ---------------------------------------------------------------------------

/// Personal de la empresa. El modulo completo de recursos humanos (nominas,
/// seguro de accidentes) llega en la Etapa 4; aqui solo lo imprescindible
/// para asignar trabajos.
model Staff {
  id String @id @default(uuid()) @db.Uuid

  /// Usuario de Supabase Auth con el que inicia sesion.
  ///
  /// NULO significa "no puede entrar al panel", y es un estado legitimo, no
  /// un dato a medias: una limpiadora necesita existir para que se le
  /// asignen trabajos, no para iniciar sesion. La sesion se resuelve por
  /// este identificador y NUNCA por el correo, asi que dar de alta a alguien
  /// con su correo no le abre ninguna puerta por si solo.
  authUserId String? @unique

  /// El correo CON EL QUE SE CREO la cuenta de acceso.
  ///
  /// Parece una copia de `email` y no lo es. `email` es el correo de
  /// contacto y se puede editar desde el panel; eso NO cambia la cuenta del
  /// proveedor, que sigue pidiendo el correo original al iniciar sesion.
  ///
  /// Se guarda porque esa diferencia ya causo un incidente real: se invito a
  /// alguien, luego se le corrigio el correo en su ficha, y a partir de ahi
  /// la pantalla mostraba una direccion con la que esa persona no podia
  /// entrar. Nadie podia saberlo mirando. Teniendo las dos, el panel lo dice.
  ///
  /// Nulo en las fichas anteriores a esta columna y en las que no tienen
  /// cuenta. Nulo significa "no lo sabemos", nunca "coinciden".
  authEmail String?

  /// Idioma en el que se le escribe.
  ///
  /// Lo tienen los clientes desde el principio y al personal le faltaba. El
  /// correo de invitacion es el PRIMER contacto con alguien que acaba de
  /// entrar en la empresa: mandarselo en un idioma que no lee es la peor
  /// primera impresion posible, y en una empresa de limpieza en Georgia no
  /// es un caso raro.
  locale Locale @default(en)

  /// Cuando se le envio la invitacion al panel, si se le envio.
  ///
  /// Se guarda para poder decir en pantalla "invitada el 3 de marzo, todavia
  /// sin entrar" en vez de dejar a quien administra sin saber si la mando o
  /// no. No sustituye a `authUserId`: la invitacion crea la cuenta al vuelo,
  /// asi que ambos se rellenan a la vez.
  invitedAt DateTime? @db.Timestamptz(3)

  firstName String
  lastName  String
  email     String    @unique
  phone     String?
  role      StaffRole @default(CLEANER)
  isActive  Boolean   @default(true)

  assignments BookingAssignment[]
  clockIns    BookingClockIn[]

  /// Las tareas que ha marcado como hechas.
  checklistItems BookingChecklistItem[]

  /// Los ajustes de campo que ha propuesto y los que ha resuelto.
  adjustmentsProposed BookingFieldAdjustment[] @relation("AjustePropuestoPor")
  adjustmentsResolved BookingFieldAdjustment[] @relation("AjusteResueltoPor")
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([isActive])
  @@map("staff")
}

model BookingAssignment {
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// Persona responsable del trabajo frente al resto del equipo.
  isLead     Boolean  @default(false)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([bookingId, staffId])
  @@index([staffId])
  @@map("booking_assignments")
}

// ---------------------------------------------------------------------------
// Configuracion y auditoria
// ---------------------------------------------------------------------------

/// Configuracion editable desde el panel de administracion: telefono, correo,
/// horarios y textos del sitio. Existe para que la empresa no dependa del
/// equipo tecnico para cambiar un dato de contacto.
model BusinessSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  updatedBy String?  @db.Uuid

  @@map("business_settings")
}

/// Una tabla de tarifas, tal y como estuvo vigente.
///
/// ES DE SOLO ANADIR: cada guardado desde el panel escribe una fila nueva y
/// NUNCA se actualiza ni se borra una anterior. El motivo esta en `Quote` y
/// en `Booking`: las dos guardan `pricingVersion` porque, sin ella, un
/// presupuesto antiguo no se puede reproducir despues de cambiar los precios.
/// Mientras las tarifas vivian en un archivo del codigo esa promesa no se
/// cumplia —del archivo solo existe su version actual—; con esta tabla, cada
/// version es una fila que se puede volver a leer.
///
/// Por eso tampoco tiene purga automatica, a diferencia de la auditoria: la
/// fila de 2026 sigue haciendo falta el dia que se revise una factura de
/// 2026.
model PricingTable {
  /// Formato `AAAA.MM.DD.n`. Se ordena sola y dice cuando se cambio el
  /// precio sin abrir la fila.
  version String @id @db.VarChar(40)

  /// Solo lo editable desde el panel: precios por servicio, extras,
  /// descuentos por recurrencia y deposito. Lo demas —duraciones, limites,
  /// impuesto, el servicio comercial— sigue en el codigo.
  rates Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String?  @db.Uuid

  /// El nombre de quien la puso, COMO TEXTO y no como referencia a su ficha.
  /// Quien subio un precio el ano pasado puede haber causado baja, y "lo
  /// cambio alguien que ya no esta" no sirve al revisar una factura.
  createdByName String? @db.VarChar(160)

  /// Para «cual es la vigente», que es la consulta de cada peticion del
  /// cotizador. La version se ordena sola por texto (AAAA.MM.DD.n), pero se
  /// indexa la fecha porque es lo que no depende del formato del
  /// identificador.
  ///
  /// EL INDICE YA EXISTIA EN LA BASE: lo creaba la migracion de la etapa
  /// 2.22, pero nadie lo declaro aqui. Prisma no lo veia, y la siguiente
  /// `migrate dev` que alguien ejecutara habria generado una migracion
  /// BORRANDOLO, mezclada con lo que esa persona estuviera haciendo.
  @@index([createdAt(sort: Desc)])
  @@map("pricing_tables")
}

/// Cada intento de aviso con su resultado. Responde a "¿le llego el correo?"
/// y, gracias al indice unico parcial, impide que un reenvio del webhook del
/// proveedor de pago acabe en un segundo correo al cliente.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  event    NotificationEvent
  channel  NotificationChannel
  audience NotificationAudience
  status   NotificationStatus

  /// A donde se envio. El panel lo ensena enmascarado.
  target            String? @db.VarChar(200)
  /// Motivo del fallo, para diagnosticar sin abrir los registros del servidor.
  failureReason     String?
  /// Identificador del proveedor, para buscar el envio en su panel.
  providerMessageId String? @db.VarChar(200)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Ademas existe un indice UNICO PARCIAL sobre
  /// (bookingId, event, channel, audience) limitado a status = SENT, creado en
  /// la migracion 20260921210000: Prisma no sabe expresar indices parciales.
  /// Es lo que convierte un reenvio en un error de clave duplicada en vez de
  /// en un segundo correo.
  @@index([bookingId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Rastro de quien hizo que. Imprescindible cuando se pueden cambiar precios
/// y cancelar cobros desde un panel.
/// SOLO SE INSERTA Y SE LEE. La aplicacion no tiene ninguna ruta que
/// actualice ni borre una fila de aqui; el unico borrado es la purga
/// programada por antiguedad. Un registro que se puede editar no prueba nada.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorType ActorType
  actorId   String?      @db.Uuid
  /// Desde donde. Ver el enumerado AuditSurface.
  surface   AuditSurface
  action    String       @db.VarChar(80)

  entityType String  @db.VarChar(40)
  entityId   String?

  /// Detalle libre. NUNCA datos de tarjeta, contrasenas ni codigos de puerta.
  metadata  Json?
  /// Direccion IP de origen, util para investigar accesos indebidos.
  ipAddress String? @db.Inet

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  /// «Que hizo esta persona»: la consulta mas frecuente al investigar algo.
  @@index([actorId, createdAt])
  /// «Ensename todas las cancelaciones» o «todos los accesos denegados».
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Los dos momentos que se fichan.
enum ClockInKind {
  ARRIVAL
  DEPARTURE
}

/// Por que un fichaje lleva o no lleva distancia.
///
/// No es un nulo con adornos: «sin ubicacion» significa tres cosas muy
/// distintas, y meterlas en el mismo cajon señalaria a una empleada por un
/// fallo de nuestra geocodificacion (NO_HOUSE).
enum ClockInLocationState {
  /// Hay distancia calculada.
  RECORDED
  /// La persona no dio permiso al navegador.
  DENIED
  /// El GPS no pudo dar una posicion: sotano, zona sin cobertura, movil viejo.
  UNAVAILABLE
  /// La casa todavia no tiene coordenadas. El fallo es NUESTRO.
  NO_HOUSE
}

/// FICHAJE CON UBICACION
///
/// Una fila por PERSONA y por EVENTO, no columnas en `Booking`: si van dos a
/// una casa, cada una ficha su llegada y una puede estar en la puerta con la
/// otra todavia en el coche. En `Booking` solo cabria una de las dos.
///
/// ==========================================================================
/// NO HAY LATITUD NI LONGITUD DEL EMPLEADO, Y ES LA DECISION MAS IMPORTANTE
/// DE ESTA ETAPA.
/// ==========================================================================
/// Las coordenadas de quien ficha llegan al servidor, se convierten en metros
/// y se descartan en el mismo metodo. No hay columna donde ponerlas.
///
/// La pregunta del negocio es «¿estaba en la casa?», y para eso la distancia
/// sobra. Guardar el punto construiria un historial de por donde anda cada
/// empleada —donde vive, a que hora sale— que no hace falta para nada. Y un
/// dato que no se guarda no se puede filtrar, ni citar en un juicio, ni pedir
/// por una orden judicial.
///
/// La base de datos ademas tiene un CHECK que obliga a que haya distancia si
/// y solo si el estado es RECORDED. Prisma no puede expresar un CHECK, asi
/// que vive solo en el archivo de migracion; esta anotado ahi.
model BookingClockIn {
  id String @id @default(uuid(4)) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// RESTRICT y no CASCADE: un fichaje es el registro de que alguien estuvo
  /// en una casa a una hora, y no debe borrarse porque se de de baja a esa
  /// persona en el sistema.
  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  kind ClockInKind

  /// Segun el reloj del SERVIDOR, no del movil: un reloj de telefono se
  /// cambia a mano, y la hora del fichaje es justo el dato que alguien
  /// tendria interes en mover.
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  locationState ClockInLocationState

  /// Metros en linea recta hasta la casa. Null si no hubo ubicacion.
  distanceMeters Int?

  /// El margen de error que reporto el navegador. SIN ESTE NUMERO LA
  /// DISTANCIA NO SE PUEDE INTERPRETAR: «a 250 m» con margen de 30 dice que
  /// no estaba en la puerta; con margen de 2000 no dice nada.
  accuracyMeters Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingId])
  /// Para el futuro modulo de nominas: los fichajes de una persona en un
  /// periodo. Se crea con la tabla vacia porque añadirlo mas tarde, con
  /// historial dentro, es una migracion que bloquea escrituras.
  @@index([staffId, occurredAt])
  @@map("booking_clock_ins")
}

/// LA LISTA DE VERIFICACION DE UN TRABAJO: UNA FILA POR TAREA MARCADA.
///
/// Esta tabla NO guarda la lista de tareas de cada reserva, solo las que se
/// han marcado. La lista que se pinta sale del catalogo del codigo
/// (`packages/types/src/job-checklist.ts`).
///
/// El precio de esa decision es una regla, y esta escrita en el contrato: un
/// codigo de tarea no se borra ni se reutiliza nunca. Es la misma que ya
/// siguen los servicios retirados y las zonas D y E: su codigo esta escrito
/// en reservas que ya existen, y borrarlo dejaria el historico ilegible. El
/// porque completo esta en la migracion 20261001160000.
model BookingChecklistItem {
  id String @id @default(uuid(4)) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// El codigo de la tarea en el catalogo. Texto y no un enumerado de
  /// Postgres: las tareas cambian al ritmo en que cambia como limpia la
  /// empresa, y con un enumerado cada cambio seria una migracion. El
  /// servidor comprueba el codigo contra el catalogo antes de escribir.
  itemCode String @db.VarChar(64)

  /// RESTRICT y no CASCADE, igual que en los fichajes: que se marco y quien
  /// lo marco es el registro de un trabajo hecho, y no debe borrarse porque
  /// se de de baja a esa persona.
  doneByStaffId String @db.Uuid
  doneBy        Staff  @relation(fields: [doneByStaffId], references: [id], onDelete: Restrict)

  /// Segun el reloj del SERVIDOR, no del movil.
  doneAt DateTime @default(now()) @db.Timestamptz(3)

  /// UNA TAREA SOLO PUEDE ESTAR MARCADA UNA VEZ EN UN TRABAJO.
  ///
  /// Es la guardia contra el doble toque, que aqui no es un caso raro: la
  /// pantalla se usa de pie, con una mano y a veces con guantes. Y es lo que
  /// hace que marcar sea idempotente, que es justo lo que hace falta con una
  /// conexion mala en la puerta de una casa.
  ///
  /// Resuelve ademas la consulta real —«las tareas de este trabajo»—, asi
  /// que no se añade un segundo indice sobre `bookingId`: seria un duplicado
  /// que solo cuesta escrituras.
  @@unique([bookingId, itemCode])
  @@map("booking_checklist_items")
}

/// Los cuatro estados de una propuesta de ajuste.
enum FieldAdjustmentState {
  /// Esperando a que coordinacion decida.
  PROPOSED
  /// Aprobada: la reserva se re-tarifico con lo encontrado.
  APPLIED
  /// Rechazada, con su motivo.
  REJECTED
  /// Sustituida por una propuesta posterior del mismo trabajo.
  SUPERSEDED
}

/// EL AJUSTE DE CAMPO: LO QUE EL EQUIPO ENCONTRO AL LLEGAR.
///
/// Esta tabla NO modifica la reserva. Guarda lo que el lider encontro, con la
/// diferencia ya calculada, y la reserva sigue intacta hasta que coordinacion
/// aprueba desde el panel. El porque completo esta en la migracion
/// 20261004120000 y en `docs/28-ajustes-de-campo.md`.
///
/// Lo contratado se COPIA aqui y no se lee de `bookings` al pintarlo: si se
/// aprueba, la reserva pasa a tener los valores nuevos y la propuesta diria
/// «de 1.300 a 1.300». El salto —que es lo unico que se revisa— se habria
/// perdido.
model BookingFieldAdjustment {
  id String @id @default(uuid(4)) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  state FieldAdjustmentState @default(PROPOSED)

  bookedSquareFeet Int
  bookedBedrooms   Int
  bookedBathrooms  Int
  bookedAddOns     Json @default("[]")

  foundSquareFeet Int
  foundBedrooms   Int
  foundBathrooms  Int
  foundAddOns     Json @default("[]")

  /// Por que. Lo lee quien va a tener que llamar al cliente.
  note String

  /// La diferencia en centavos. NULL cuando no hay precio automatico: una
  /// casa por encima del ultimo tramo de la tabla no se tarifa sola.
  differenceCents Int?
  newTotalCents   Int?

  /// POR QUE no hay precio automatico, cuando no lo hay.
  ///
  /// El motor se niega por siete razones distintas y casi nunca es el tamano:
  /// la mas frecuente es la ZONA, porque fuera de las 35 millas Georgia
  /// entera se atiende sin precio automatico por diseno. Juntarlas todas en
  /// un mensaje hacia buscar el problema donde no estaba.
  noPriceReasonKey String?

  /// Si el total lo TECLEO una persona en vez de calcularlo el motor.
  ///
  /// Se marca porque un total calculado y uno tecleado valen lo mismo en la
  /// factura y no valen lo mismo al revisar las cuentas de un mes. Hay un
  /// CHECK en la migracion que solo lo admite en una propuesta aplicada.
  manualPrice Boolean @default(false)

  /// La version de tarifas con la que se calculo: la de la RESERVA, no la
  /// vigente. Aprobar un ajuste no puede colar los precios de hoy en un
  /// trabajo contratado el mes pasado.
  pricingVersion String

  /// RESTRICT, como los fichajes: es el registro de lo que alguien vio en una
  /// casa, y no debe borrarse porque se de de baja a esa persona.
  proposedByStaffId String   @db.Uuid
  proposedBy        Staff    @relation("AjustePropuestoPor", fields: [proposedByStaffId], references: [id], onDelete: Restrict)
  proposedAt        DateTime @default(now()) @db.Timestamptz(3)

  resolvedByStaffId String?   @db.Uuid
  resolvedBy        Staff?    @relation("AjusteResueltoPor", fields: [resolvedByStaffId], references: [id], onDelete: Restrict)
  resolvedAt        DateTime? @db.Timestamptz(3)
  resolutionNote    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  /// La consulta real es «los ajustes de este trabajo, el mas reciente
  /// primero». Ademas hay dos CHECK en la migracion que Prisma no ve.
  @@index([bookingId, proposedAt(sort: Desc)])
  @@map("booking_field_adjustments")
}
