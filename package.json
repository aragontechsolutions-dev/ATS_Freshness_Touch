{
  "name": "freshness-touch",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestion web para Freshness Touch (empresa de limpieza, Georgia USA)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
